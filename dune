; The `static` profile (`make release`) links libc in, so the binary runs on
; any Linux of the same architecture. It needs libc.a on the build host; macOS
; has none, so build there with `make release STATIC=0`.

(env
 (static
  (link_flags
   (:standard -ccopt -static))))

; Installs the stdlib to <prefix>/share/writ/lib/, where the `(load "FILE")`
; resolver looks. dune takes no globs, so a new file in core/stdlib/ ships
; everywhere except opam until it is named here.

(install
 (section share)
 (package writ)
 (files
  (core/stdlib/stdlib.writ as lib/stdlib.writ)
  (core/stdlib/ct.rules as lib/ct.rules)))

; lean/ is built by lake; keep dune out of its .lake tree.

(dirs :standard \ lean)
