; stdlib.writ — the Writ Standard Library
;
; Generic forms and schemas only: no domain vocabulary, no policy.

; 1. Derived logic
; Universal roster quantification, from the kernel's `some`.
(form (all (X T) G) (not (some (X T) (not G))))

; 2. Equality and difference
; Kleene equality: vacuously true where either side has no answer, so an
; unstaffed office breaks no seconding rule.
(form (= A B) (not (and (defined A) (defined B) (not (is A B)))))

; Strict difference. Unlike `=`, an undefined side makes `differ` true: a
; vacant approver differs from every preparer. For "both filled and
; different", write (and (defined A) (defined B) (differ A B)).
(form (differ A B) (not (is A B)))

; 3. The quiver schema — dynamics as data
; `writ control MODEL.writ` exports a model's control quiver as an instance of
; this schema, one `edge` per transition. Behaviour then becomes an ordinary
; instance, so e.g. `writ solve --simulation` (interrogator §3) is just the
; map search run between two quiver-instances.
;
; Names are global (kernel §7), so loading this file reserves `node` and
; `edge` here, and `ob`, `hom` and `eqn` in §7.
(schema quiver
  (type node)
  (type edge
    (arrow src (to node) fixed)
    (arrow tgt (to node) fixed)))

; 4. Spans
; A many-to-many relation between A and B, as a junction type. Not named
; `relation`, which a .rules file uses for its own declarations (interrogator
; §1); forms expand in every file type.
(form (span R A B)
  (type R
       (arrow left  (to A) fixed)
       (arrow right (to B) fixed)))

; 5. Behaviour templates
; A two-state flip on path P between values A and B — two guarded moves,
; never a fake self-loop.
(form (toggle P A B)
  (transition (when (is P A)) (do (set P B)))
     (transition (when (is P B)) (do (set P A))))

; A one-way latch: once P leaves A for B, no move here brings it back.
(form (latch P A B)
  (transition (when (is P A)) (do (set P B))))

; 6. The phase idiom
; A model with modes declares an enumerated mode type, one mutable arrow to
; it, and conjoins each mode-restricted move's guard with the mode test.
(form (phase-gated P V G) (and (is P V) G))

; 7. The olog schema — schemas as data
; An instance of `olog` is a schema: its types, arrows and equations.
; `writ schema MODEL.writ` emits one. Dictionary totality and shape (kernel
; §16.4) then become an ordinary instance homomorphism search; equation
; preservation stays semantic. See docs/schema-as-data.md.
(schema olog

  ; A schema's types. Enumerated vs open is a fact about members, which live
  ; one level down, in the instance.
  (type ob)

  ; A schema's arrows. Arrow names are scoped to their dom (§7), so the
  ; emitter makes hom names unique; `dom` and `cod` carry the meaning. Both
  ; are `fixed`: a schema does not change over world-time (§6.3), so an
  ; olog-instance has one situation.
  (type hom
    (arrow dom (to ob) fixed)
    (arrow cod (to ob) fixed))

  ; A law, by name only. A law's body is a guard tree (§8.6), and the checks
  ; this schema serves read only `dom` and `cod`. Names alone let "which laws
  ; survived" be a set difference.
  (type eqn))

; `olog` is expressible as an instance of itself (ob = {ob, hom, eqn},
; hom = {dom, cod}), and that instance builds. Only a law's body is beyond the
; encoding.

; 8. Optional arrows
; `(maybe A T)` is exactly `(arrow A (to T) vacatable)`. It wraps the whole
; datum because a form in list position must expand to one datum
; (`Expander.expr`), so a `(to T) vacatable` template is impossible.
;
; There is no short spelling for `fixed vacatable`, e.g.
;
;   (type tick (arrow next (to tick) fixed vacatable))
;
; which is now more common than the plain vacatable arrow. Whether it deserves
; one is open.
(form (maybe A T) (arrow A (to T) vacatable))
