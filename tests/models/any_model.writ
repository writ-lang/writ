; any_model.writ — a Complete Worked Model
;
; A small republic: a government with bills and an emergency regime, a
; watchdog, a prosecution bureau, and a case wired through both. Claims are in
; any_model.claims; amendments are git commits.

(load "stdlib.writ")
(load "politics.lib.writ")

; The starting configuration
(instance day-one politics
  (chamber assembly)
  (people electorate)
  (bureau watchdog (independence independent))
  (bureau prosecutions (independence independent))
  (case docket (investigator watchdog)
               (prosecutor prosecutions)
               (stage investigating))
  (government gov (executive-bloc incumbent-party)
                  (bill none)
                  (mood favours-incumbent)
                  (support majority)
                  (regime normal)))

(use politics)
(initial day-one)

; Dynamics
; The ordinary machinery of government:
(bill-cycle gov)                       ; pass / sign / veto / override
(case-pipeline docket)                 ; investigate → prosecute → conclude
(swing gov)                            ; the electorate's mood, via stdlib toggle

; The contested moves: the assembly may capture either bureau — and, under
; the current text, restore either. HOLDER slots are editorial.
(captured-by watchdog      assembly)
(captured-by prosecutions  assembly)
(restored-by watchdog      assembly)
(restored-by prosecutions  assembly)

; Emergency rule: declared freely, lifted only while the assembly still
; commands a majority — an asymmetry with consequences the claims probe.
(power declare-emergency
  (when (is gov.regime normal))
  (does (set gov.regime emergency)))

(power lift-emergency
  (when (phase-gated gov.regime emergency (at-least-majority gov)))
  (does (set gov.regime normal)))

; A modelled boundary: if support has collapsed to a minority during an
; emergency, the written rules run out — whoever acts next is outside them.
(power emergency-without-majority
  (when (phase-gated gov.regime emergency (is gov.support minority)))
  (does (gap "emergency rule with minority support: the text is silent")))

; Support erosion and recovery, one step at a time.
(transition support-erodes-1
  (when (is gov.support supermajority)) (do (set gov.support majority)))
(transition support-erodes-2
  (when (is gov.support majority))      (do (set gov.support minority)))
(transition support-recovers
  (when (is gov.support minority))      (do (set gov.support majority)))
