; Loads the standard library and still means `relation`: forms expand in every
; file type, so stdlib must not define a `relation` form (it is `span`,
; extension §10). The stdlib's schemas are skipped, not rejected.

(load "stdlib.writ")

(relation subordinate (person person))

(rule (subordinate X Y)
  (is X.reports-to Y))

(rule (subordinate X Y)
  (is X.reports-to Z)
  (subordinate Z Y))
