; clean.pol — a minimal well-formed model: no failing property, no equations.
; `pol check clean.pol` prints the report and exits 0.

(schema tiny
  (type flag (lo hi))
  (type box (arrow f (to flag))))

(instance i (of tiny)
  (box b)
  (f (b lo)))

(use tiny)
(initial i)

(transition raise (when (is b.f lo)) (do (set b.f hi)))
(transition lower (when (is b.f hi)) (do (set b.f lo)))
