; rules_base.writ — the small org model the .rules fixtures interrogate.
;
; `reports-to` is FIXED on purpose: it is wiring, so it reads the same in every
; situation, which is what makes extension §1's own base case
; `(rule (subordinate X Y) (is X.reports-to Y))` a legal BARE guard literal —
; one with no situation to evaluate it in. A mutable arrow there would have to
; be wrapped in `(holds S …)`.
;
; `stands` is mutable, and the two transitions give the model four reachable
; situations, so a rules file can also ask questions about the derived
; category (indices 0..3) rather than the instance alone.

(schema org
  (type stance (quiet vocal))
  (type person
    (arrow reports-to (to person) fixed)   ; who reports to whom — the wiring
    (arrow stands (to stance))))           ; a person's current stance

(instance org-chart org
  (person nabu (reports-to mid)
               (stands quiet))
  (person mid (reports-to cabinet)
              (stands quiet))
  (person cabinet (reports-to vacant)
                  (stands quiet))
  ; every fixed cell must be given a value (state.ml), and the top of a chart
  ; reports to nobody — so the cabinet's cell is explicitly vacant.
)

(use org)
(initial org-chart)

(transition nabu-speaks
  (when (is nabu.stands quiet))
  (do (set nabu.stands vocal)))

(transition mid-speaks
  (when (is mid.stands quiet))
  (do (set mid.stands vocal)))
