; The small org model the .rules fixtures interrogate. `reports-to` is fixed,
; so §1's `(is X.reports-to Y)` is a legal bare guard; `stands` is mutable,
; giving four situations (indices 0..3).

(schema org
  (type stance (quiet vocal))
  (type person
    (arrow reports-to (to person) fixed)   ; who reports to whom — the wiring
    (arrow stands (to stance))))           ; a person's current stance

(instance org-chart org
  (person nabu (reports-to mid)
               (stands quiet))
  (person mid (reports-to cabinet)
              (stands quiet))
  (person cabinet (reports-to vacant)
                  (stands quiet))
  ; every fixed cell needs a value, so the top of the chart is vacant
)

(use org)
(initial org-chart)

(transition nabu-speaks
  (when (is nabu.stands quiet))
  (do (set nabu.stands vocal)))

(transition mid-speaks
  (when (is mid.stands quiet))
  (do (set mid.stands vocal)))
