; ALL-CAPS element names: fine in .writ, but a .rules file reads them as
; variables (extension §1). caps_collision.rules trips that diagnostic.

(schema caps
  (type kind-t (KNIGHT KNAVE))
  (type islander
    (arrow kind (to kind-t) fixed)
    (arrow says (to kind-t))))

(instance camp caps
  (islander alice (kind KNIGHT)
                  (says KNIGHT))
  (islander bob (kind KNAVE)
                (says KNIGHT)))

(use caps)
(initial camp)

(transition bob-recants
  (when (is bob.says KNIGHT))
  (do (set bob.says KNAVE)))
