; The smallest cyclic derived category: two situations, a move each way.
; `reach` derives every pair, which strains derivation acyclicity.

(schema toggle
  (type flag (lo hi))
  (type box (arrow f (to flag))))

(instance i toggle
  (box b (f lo)))

(use toggle)
(initial i)

(transition up   (when (is b.f lo)) (do (set b.f hi)))
(transition down (when (is b.f hi)) (do (set b.f lo)))
