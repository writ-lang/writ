; A reachable state whose only move is a (gap …): an exit, so it is not
; absorbing. Reports `reachable gaps: 1`, `absorbing states: 0`.

(schema tiny
  (type flag (lo hi))
  (type box (arrow f (to flag))))

(instance i tiny
  (box b (f lo)))

(use tiny)
(initial i)

(transition go   (when (is b.f lo)) (do (set b.f hi)))
(transition boom (when (is b.f hi)) (do (gap "off the edge")))
