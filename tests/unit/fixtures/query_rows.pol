; query_rows.pol — a model whose INITIAL situation already has a captured
; bureau, so the sibling query `captured` returns a row at state 0 (no --at
; needed). `pol query query_rows.pol captured` prints
; `captured  (at state 0)` and a `b = watchdog` binding row.

(schema tiny
  (type indep (independent captured))
  (type bureau
    (arrow independence (to indep))))

(instance i tiny
  (bureau watchdog (independence captured))
  (bureau prosecutions (independence independent)))

(use tiny)
(initial i)
