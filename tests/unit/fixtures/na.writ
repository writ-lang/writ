; A minimal model; its sibling na.claims has a property that is n/a (§8):
; `n/a  phantom-arrow`, exit 1 — an unanswered question is a finding.

(schema tiny
  (type flag (lo hi))
  (type box (arrow f (to flag))))

(instance i tiny
  (box b (f lo)))

(use tiny)
(initial i)

(transition raise (when (is b.f lo)) (do (set b.f hi)))
(transition lower (when (is b.f hi)) (do (set b.f lo)))
