; The engine unit tests: stdlib only, plain assertions that exit on failure.
;
; The .writ data is a declared dependency so dune copies it into the build
; context; climbing out of _build to the source tree breaks once
; `dune build @install` puts core/stdlib inside _build.

(tests
 (names
  test_core
  test_syntax
  test_data
  test_rules
  test_rules_parser
  test_rules_sorts
  test_rules_check
  test_rules_fixtures
  test_derive
  test_report_derive
  test_engine
  test_control
  test_schema_data
  test_compare
  test_loadpath
  test_names
  test_binders
  test_forms_position
  test_set_as_chain
  test_law_as_guard
  test_ct_rules
  test_facts
  test_sql)
 (deps
  (glob_files fixtures/*.{writ,claims,rules})
  (glob_files %{workspace_root}/tests/models/*.{writ,claims})
  (glob_files %{workspace_root}/core/stdlib/*.{writ,rules}))
 (libraries writ_data writ_syntax writ_runtime writ_loadpath writ_sql))

; The --stdin behaviour, through [writ_cli] (a library so a test can link it).
; Its own stanza because [writ_cli] is unwrapped and would put [Help],
; [Cmd_check] and the rest in scope for every engine test.

(test
 (name test_stdin)
 (libraries writ_cli))

; The JSON rendering: serialise, parse back, read the members. Its own stanza
; because [writ_report_json] is unwrapped, as above.

(test
 (name test_origin)
 (deps
  (glob_files fixtures/*.{writ,claims,rules}))
 (libraries writ_data writ_syntax writ_runtime writ_json writ_report_json))

(test
 (name test_graph)
 (deps
  (glob_files fixtures/*.{writ,claims,rules})
  (glob_files %{workspace_root}/tests/models/*.{writ,claims})
  (glob_files %{workspace_root}/core/stdlib/*.{writ,rules}))
 (libraries writ_data writ_syntax writ_runtime))

(test
 (name test_report_json)
 (deps
  (glob_files fixtures/*.{writ,claims,rules})
  (glob_files %{workspace_root}/tests/models/*.{writ,claims})
  (glob_files %{workspace_root}/core/stdlib/*.{writ,rules}))
 (libraries writ_data writ_syntax writ_runtime writ_json writ_report_json))

; The language server: [Server.handle] is pure, and the resolver serves
; fixture text from memory.

(test
 (name test_lsp)
 (libraries writ_data writ_syntax writ_runtime writ_lsp))

