; The engine unit tests. OCaml stdlib only, no external framework: plain
; assertions that raise on failure and print a pass summary. They link the three
; engine libraries — the data model, the front end, and the interrogator.

; The .writ data the tests read is declared as a dependency, so dune copies it
; into the build context the tests actually run in. Without this they only
; worked by climbing OUT of _build to the source tree — which broke the moment
; `dune build @install` put core/stdlib/*.writ inside _build, because the climb
; then stopped at _build/default, where tests/models and the fixtures were not.

(tests
 (names
  test_core
  test_syntax
  test_data
  test_rules
  test_rules_parser
  test_rules_sorts
  test_rules_check
  test_rules_fixtures
  test_derive
  test_report_derive
  test_engine
  test_control
  test_schema_data
  test_compare
  test_loadpath
  test_names
  test_binders
  test_forms_position
  test_set_as_chain
  test_law_as_guard
  test_ct_rules
  test_facts
  test_sql
  test_mgtt)
 (deps
  (glob_files fixtures/*.{writ,claims,rules,json})
  (glob_files %{workspace_root}/tests/models/*.{writ,claims})
  (glob_files %{workspace_root}/core/stdlib/*.{writ,rules}))
 (libraries
  writ_data
  writ_syntax
  writ_runtime
  writ_loadpath
  writ_sql
  writ_mgtt))

; The language-server tests drive [Server.handle] (pure: JSON in, JSON out), so
; they link the [writ_lsp] library alongside the engine. No I/O — the resolver
; serves fixture text from an in-memory map.

(test
 (name test_lsp)
 (libraries writ_data writ_syntax writ_runtime writ_lsp))

; The MCP server tests, likewise: [Server.handle] is pure (JSON in, JSON out),
; so they link [writ_mcp] and drive the whole protocol with no process and no
; pipe. The resolver serves fixture text from an in-memory map.

(test
 (name test_mcp)
 (libraries writ_data writ_syntax writ_runtime writ_mcp writ_json))
