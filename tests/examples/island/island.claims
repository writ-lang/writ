; The questions about the census.

(property census-completable
  "every native can be assigned a kind"
  (possible (and (defined abe.kind) (defined bea.kind) (defined cal.kind))))

; "Which natives could be knights?" — the island's Wish-6 question, asked
; per native so the answer is a definite holds/fails rather than a query whose
; rows depend on which state you address. abe and bea (who said "knight") can
; each be read as a knight; cal (who said "knave") can be read as nothing at
; all — the only move that reads cal is the declared hole.
(property abe-can-be-knight "abe could be a knight" (possible (is abe.kind knight)))
(property bea-can-be-knight "bea could be a knight" (possible (is bea.kind knight)))
(property cal-can-be-knight "cal could be a knight" (possible (is cal.kind knight)))

; The spec's original query — the set of natives currently classified knight in
; the addressed situation (empty at the initial census, before anyone is read).
(query possible-knights
  (where (n native))
  (is n.kind knight))
