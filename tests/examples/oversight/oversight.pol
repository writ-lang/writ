; The kernel-spec's running example (§4): an oversight system with two
; agencies (a watchdog investigator and a prosecutions bureau), one case
; (docket) and one — possibly vacant — judge.
;
; Schema, instance, equation and the capture/restore/assign moves are §4
; VERBATIM. ONE token differs from §4's text: `conclude` guards on the
; INVESTIGATOR's independence (docket.investigator.independence), not the
; prosecutor's. In §4 as printed the capture power (over the watchdog =
; investigator) and the conclusion dependency (on the prosecutor) are decoupled,
; so no repeal of restoration could ever cost accountability — verified: the
; compare stays `preserved`, exit 0. Coupling conclude to the investigator makes
; the capture power actually bear on whether the case concludes: capturing the
; watchdog stalls the case, and restore-watchdog is what keeps accountability
; alive. This keeps the same-agency breaker list exactly {capture-watchdog,
; restore-watchdog}; capturing prosecutions instead would add two more breakers.
;
; The legislature retains powers over the oversight bodies (capture / restore the
; watchdog's independence). The schema declares a structural law, `same-agency`:
; the two routes case → indep-status (via investigator, via prosecutor) must
; agree — the investigating and prosecuting agencies stand on equal footing.

(load "stdlib.pol")   ; `=` is a stdlib form (§8.6); there is no implicit prelude

(schema oversight
  (type indep-status (independent captured))
  (type stage-t (open concluded))
  (type person
    (arrow employer (to bureau) fixed))
  (type bureau
    (arrow independence (to indep-status)))
  (type case
    (arrow stage        (to stage-t))
    (arrow investigator (to bureau) fixed)
    (arrow prosecutor   (to bureau) fixed)
    (maybe judge        person))
  (equation same-agency
    (= case.investigator.independence case.prosecutor.independence)))

(instance day-one (of oversight)
  (bureau watchdog prosecutions)
  (person alice)
  (case docket)
  (employer      (alice watchdog))
  (investigator  (docket watchdog))
  (prosecutor    (docket prosecutions))
  (independence  (watchdog independent) (prosecutions independent))
  (stage         (docket open))
  (judge         (docket vacant)))

(use oversight)
(initial day-one)

(transition capture-watchdog
  (when (is watchdog.independence independent))
  (do (set watchdog.independence captured)))

(transition restore-watchdog
  (when (is watchdog.independence captured))
  (do (set watchdog.independence independent)))

(transition conclude
  (when (and (is docket.stage open)
             (is docket.investigator.independence independent)))
  (do (set docket.stage concluded)))

(transition assign-judge
  (when (not (defined docket.judge)))
  (do (set docket.judge alice)))
