; The questions, kept apart from the shop (Prologue wish 12).
(load "../scheduling.lib.pol")

; Some schedule finishes everything — the shop is not broken outright.
(property all-finish "every job can finish"
  (possible (all-done j)))

; But can it always STILL finish, whatever has happened so far? This is the
; trap detector (wish 8): a `possible` that holds tells you a good schedule
; exists, and says nothing about the bad ones you can walk into first.
(property never-stuck "from every reachable schedule, every job can still finish"
  (live (all-done j)))
