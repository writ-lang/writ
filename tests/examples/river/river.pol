; The Prologue's river crossing (kernel-spec Appendix C).
; A farmer, a wolf, a goat, a cabbage; a boat holding the farmer + one passenger.
; Left unattended with its prey on a bank, the wolf eats the goat, the goat the
; cabbage. Can everything cross intact?
;
; Faithful to Appendix C, with two refinements so the tool tells the truth:
;   (1) each move is NAMED (the leading form slot) so `pol` prints a legible
;       solution path — Appendix C's own report shows named moves;
;   (2) APPETITE IS FORCED, not optional. In the puzzle nature is not a move the
;       farmer may decline: strand a predator with its prey and the prey IS
;       eaten. So the farmer may only act from a SAFE arrangement (the `safe`
;       guard below); the instant he strands prey, he is frozen and the only
;       move left is the eat. Without this, `(possible solvable)` finds a shorter
;       path that reaches the far bank only by never *choosing* to let anything
;       be eaten — a "solution" that abandons the goat. With it, the solution
;       `pol` prints is a real, safe crossing, and `no-blunders` still fails
;       (stranding is reachable and dooming).

(schema river
  (type bank (left right))
  (type traveler
    (arrow at (to bank)))
  (type cargo
    (arrow at (to bank) vacatable)))     ; eaten: nowhere — Wish 2

(instance start (of river)
  (traveler farmer)
  (cargo wolf goat cabbage)
  (at (farmer left) (wolf left) (goat left) (cabbage left)))

(use river)
(initial start)

; SAFE: no predator is stranded with its prey — i.e. no danger pair shares a
; bank the farmer has left. (A vacant/eaten piece is `at` nowhere, so it drops
; out of these tests.)
(form safe =>
  (not (or (and (is wolf.at left)  (is goat.at left)     (is farmer.at right))
           (and (is wolf.at right) (is goat.at right)    (is farmer.at left))
           (and (is goat.at left)  (is cabbage.at left)  (is farmer.at right))
           (and (is goat.at right) (is cabbage.at right) (is farmer.at left)))))

; compound moves, named once — Wish 11. The farmer may only move from a safe
; arrangement; strand prey and he is frozen until appetite has acted.
(form (row NAME FROM TO)
  => (transition NAME (when (and safe (is farmer.at FROM))) (do (set farmer.at TO))))

(form (ferry NAME C FROM TO)
  => (transition NAME
       (when (and safe (is farmer.at FROM) (is C.at FROM)))
       (do (set farmer.at TO) (set C.at TO))))

(row cross-empty-LR   left right)   (row cross-empty-RL   right left)
(ferry cross-wolf-LR    wolf    left right)  (ferry cross-wolf-RL    wolf    right left)
(ferry cross-goat-LR    goat    left right)  (ferry cross-goat-RL    goat    right left)
(ferry cross-cabbage-LR cabbage left right)  (ferry cross-cabbage-RL cabbage right left)

; nature's move: on a bank the farmer has left, appetite acts. From an unsafe
; arrangement this is the ONLY enabled move (the farmer is frozen), so it fires.
(form (eats NAME P Q BANK OTHER)
  => (transition NAME
       (when (and (is P.at BANK) (is Q.at BANK) (is farmer.at OTHER)))
       (do (vacate Q.at))))            ; the eaten piece is gone

(eats wolf-eats-goat-L    wolf goat    left  right)
(eats wolf-eats-goat-R    wolf goat    right left)
(eats goat-eats-cabbage-L goat cabbage left  right)
(eats goat-eats-cabbage-R goat cabbage right left)
