; queens-unordered.pol — the eight queens puzzle.
;
; One queen per COLUMN is built into the data rather than checked: `q3` IS the
; queen of column 3, so the column rule cannot be broken because it cannot be
; written. What remains is rows and diagonals.
;
; Rows are ENTITIES on a ladder rather than an enumerated set. `next` climbs it,
; `prev` descends, and both run off the board into `vacant` — which is what lets
; a diagonal be SAID instead of enumerated: a queen d columns away attacks the
; square d rows up or down, and `R.next.next` is that square. Falling off the
; board leaves the chain undefined, `is` is strict, so `differ` is true and the
; edge of the board constrains nothing. Exactly right, and for free.
;
; The three-way test is named once per distance (`safe2` = "two columns away")
; and a form's slot substitutes into a chain's ROOT, so `R.next.next` becomes
; `r5.next.next` at the call. Each transition then reads as what it means: one
; conjunct per other queen, not one per forbidden row.
;
; FREE placement: any column, any time. The same 92 boards, but the space holds
; every safe SUBSET of columns rather than every prefix — 118969 situations
; against queens.pol's 2057. It does not finish in ten minutes, and is kept as
; the measured contrast, not as a test.


(load "stdlib.pol")


(schema board
  (type row-t
    (arrow next (to row-t) fixed vacatable)
    (arrow prev (to row-t) fixed vacatable))
  (type queen (arrow row (to row-t) vacatable)))

(form (safe1 P R)
  => (and (differ P R) (differ P R.next) (differ P R.prev)))
(form (safe2 P R)
  => (and (differ P R) (differ P R.next.next) (differ P R.prev.prev)))
(form (safe3 P R)
  => (and (differ P R) (differ P R.next.next.next) (differ P R.prev.prev.prev)))
(form (safe4 P R)
  => (and (differ P R) (differ P R.next.next.next.next) (differ P R.prev.prev.prev.prev)))
(form (safe5 P R)
  => (and (differ P R) (differ P R.next.next.next.next.next) (differ P R.prev.prev.prev.prev.prev)))
(form (safe6 P R)
  => (and (differ P R) (differ P R.next.next.next.next.next.next) (differ P R.prev.prev.prev.prev.prev.prev)))
(form (safe7 P R)
  => (and (differ P R) (differ P R.next.next.next.next.next.next.next) (differ P R.prev.prev.prev.prev.prev.prev.prev)))

(instance empty (of board)
  (row-t r1 r2 r3 r4 r5 r6 r7 r8)
  (queen q1 q2 q3 q4 q5 q6 q7 q8)
  (next (r1 r2) (r2 r3) (r3 r4) (r4 r5) (r5 r6) (r6 r7) (r7 r8) (r8 vacant))
  (prev (r1 vacant) (r2 r1) (r3 r2) (r4 r3) (r5 r4) (r6 r5) (r7 r6) (r8 r7))
  (row (q1 vacant) (q2 vacant) (q3 vacant) (q4 vacant) (q5 vacant) (q6 vacant) (q7 vacant) (q8 vacant)))

(use board)
(initial empty)

(transition place-1-1
  (when (and (not (defined q1.row)) (safe1 q2.row r1)
             (safe2 q3.row r1) (safe3 q4.row r1)
             (safe4 q5.row r1) (safe5 q6.row r1)
             (safe6 q7.row r1) (safe7 q8.row r1)))
  (do (set q1.row r1)))

(transition place-1-2
  (when (and (not (defined q1.row)) (safe1 q2.row r2)
             (safe2 q3.row r2) (safe3 q4.row r2)
             (safe4 q5.row r2) (safe5 q6.row r2)
             (safe6 q7.row r2) (safe7 q8.row r2)))
  (do (set q1.row r2)))

