; queens-unordered.pol — the same board, without the ordering commitment.
;
; Same library, same squares, same `free` test: chess.lib.pol beside this file
; holds all of it. Only the moves differ, which is what makes the comparison
; against queens.pol a measurement rather than a claim.
;
; WHAT IS MISSING IS THE CURSOR. chess.lib.pol declares one — a library offers
; vocabulary, it does not impose it — and this model simply never touches it.
; It cannot: a cursor only exists if there IS an order to advance along, and
; dropping the order is the whole point here. So every (column, row) pair needs
; its own move again: SIXTY-FOUR of them.
;
; They are written as eight `(column …)` lines, and the square is never named —
; `Q.sqN` IS the square, reached by a chain, which is §10.3's widening earning
; its place in the model that otherwise argues for what it does not buy. But
; sixty-four moves is what this HAS, however few lines declare them.
;
; The 92 boards are identical to queens.pol's. The space is not: 118969
; situations against 2057, because every ORDER of arrival at the same board is
; its own route. NOT run by the suite — ~30s against a fifth of a second.

(load "chess.lib.pol")
(use board)
(initial empty)

; A whole column in one line. Only the move NAMES have to be supplied, and they
; are what makes a route readable: `p11, p23, p35, …` IS the board, left to
; right.
(form (column Q N1 N2 N3 N4 N5 N6 N7 N8)
  => (transition N1 (when (and (not (defined Q.at)) (free p Q.sq1))) (do (set Q.at Q.sq1)))
     (transition N2 (when (and (not (defined Q.at)) (free p Q.sq2))) (do (set Q.at Q.sq2)))
     (transition N3 (when (and (not (defined Q.at)) (free p Q.sq3))) (do (set Q.at Q.sq3)))
     (transition N4 (when (and (not (defined Q.at)) (free p Q.sq4))) (do (set Q.at Q.sq4)))
     (transition N5 (when (and (not (defined Q.at)) (free p Q.sq5))) (do (set Q.at Q.sq5)))
     (transition N6 (when (and (not (defined Q.at)) (free p Q.sq6))) (do (set Q.at Q.sq6)))
     (transition N7 (when (and (not (defined Q.at)) (free p Q.sq7))) (do (set Q.at Q.sq7)))
     (transition N8 (when (and (not (defined Q.at)) (free p Q.sq8))) (do (set Q.at Q.sq8))))

; Sixty-four moves, eight lines.
(column q1 p11 p12 p13 p14 p15 p16 p17 p18)
(column q2 p21 p22 p23 p24 p25 p26 p27 p28)
(column q3 p31 p32 p33 p34 p35 p36 p37 p38)
(column q4 p41 p42 p43 p44 p45 p46 p47 p48)
(column q5 p51 p52 p53 p54 p55 p56 p57 p58)
(column q6 p61 p62 p63 p64 p65 p66 p67 p68)
(column q7 p71 p72 p73 p74 p75 p76 p77 p78)
(column q8 p81 p82 p83 p84 p85 p86 p87 p88)
