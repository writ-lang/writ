; Access & privilege (§3, "Access and privilege").
;
; Accounts carry a role (user | admin) and a `sponsor` — the account that
; vouches for them — plus a fixed `source` of authority (the security root, or
; something external). The law `traces-to-root` demands each account's authority
; be inherited from its sponsor: two routes account → source-t that must agree.
; A delegation that rewires a sponsor to an externally-sourced account breaks it.
;
; The interesting question is revocation. Most admin grants are reversible. But
; `grant-breakglass-admin` is a DESIGNED LATCH: an emergency admin that, once
; granted, has no revoke move. It is the irreversible grant §3 asks the model to
; declare — here, on purpose (break-glass), not a defect.

(load "stdlib.pol")   ; `=` is a stdlib form (§8.6); there is no implicit prelude

(schema access
  (type role-t   (user admin))
  (type source-t (root external))
  (type account
    (arrow role    (to role-t))            ; user | admin (granted / revoked)
    (arrow sponsor (to account))           ; who vouches for this account
    (arrow source  (to source-t) fixed))   ; where this account's authority comes from
  ; every account's authority is inherited from its sponsor — the chain to root:
  (equation traces-to-root
    (= account.sponsor.source account.source)))

(instance baseline (of access)
  (account root alice mallory)
  (role    (root user) (alice user) (mallory user))
  (sponsor (root root) (alice root) (mallory mallory))
  (source  (root root) (alice root) (mallory external)))

(use access)
(initial baseline)

; Reversible admin grant for a rank-and-file account.
(transition grant-alice-admin
  (when (is alice.role user))
  (do (set alice.role admin)))

(transition revoke-alice-admin
  (when (is alice.role admin))
  (do (set alice.role user)))

; The DESIGNED LATCH: the break-glass emergency admin. Once granted there is no
; revoke — by design. This is what makes revocation-possible FAIL.
(transition grant-breakglass-admin
  (when (is mallory.role user))
  (do (set mallory.role admin)))

; The grant that can break traces-to-root: rewire alice's sponsor to mallory,
; whose source is `external`, not the security root.
(transition delegate-alice-to-mallory
  (when (is alice.sponsor root))
  (do (set alice.sponsor mallory)))
