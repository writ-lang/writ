; The command line. [Writ] is a thin executable doing argument dispatch over
; the [writ_cli] library: one [Cmd_*] module per verb, [Cli_io] for shared I/O,
; [Help] for `--help`. The verbs are a library so tests can link them; it is
; unwrapped so module names stay [Cli_io], [Cmd_*], etc.

(library
 (name writ_cli)
 (wrapped false)
 (modules
  cli_io
  certifier
  cmd_check
  cmd_query
  cmd_compare
  cmd_control
  cmd_schema
  cmd_derive
  cmd_show
  cmd_graph
  cmd_sql
  help
  writ_dispatch)
 (libraries
  writ_data
  writ_syntax
  writ_runtime
  writ_loadpath
  writ_sql
  writ_json
  writ_report_json))

(executable
 (name writ)
 (public_name writ)
 (package writ)
 (modules writ version)
 (libraries writ_cli))

; `writ --version` is generated from dune-project's version. A leading `v`
; before a digit is stripped: `dune subst` (run by every `opam pin`) sets the
; version from `git describe`, giving "v0.2.0" where tarball and opam say
; "0.2.0".

(rule
 (targets version.ml)
 (action
  (with-stdout-to
   version.ml
   (echo
    "let v =\n  let raw = \"%{version:writ}\" in\n  if String.length raw > 1 && raw.[0] = 'v' && raw.[1] >= '0' && raw.[1] <= '9'\n  then String.sub raw 1 (String.length raw - 1)\n  else raw\n"))))
