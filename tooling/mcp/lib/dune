; The MCP server as a pure library: JSON in, JSON out, no I/O. It links the
; three engine libraries for the same reason [pol_lsp] does — an answer from a
; tool call must be an answer `pol check` would give, and a second
; implementation would be a second set of bugs.

(library
 (name pol_mcp)
 (libraries pol_data pol_syntax pol_runtime pol_json))

; The same generated version the CLI reports, for `initialize`'s serverInfo: a
; client that asks which pol it is talking to must not get a hand-kept copy.
; It lives in the library rather than beside the binary — see bin/dune.

(rule
 (targets version.ml)
 (action
  (with-stdout-to
   version.ml
   (echo "let v = \"%{version:pol}\"\n"))))
