; The MCP server process, installed as `writ-mcp`; the only I/O in the MCP tree.

; Keep this a single module: the main module shares its name with the library,
; so a second module makes [Writ_mcp.Server] resolve to the executable and the
; build fails. That is why [Version] lives in the library.

(executable
 (name writ_mcp)
 (public_name writ-mcp)
 (package writ)
 (modules writ_mcp)
 (libraries
  writ_data
  writ_syntax
  writ_runtime
  writ_mcp
  writ_json
  writ_report_json
  writ_loadpath))
