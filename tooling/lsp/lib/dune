; The language server as a pure library: strings in, strings out, no I/O. It
; links the engine libraries so diagnostics come from the real parser. The
; layer folders (wire, doc, feature) are flattened into one library.

(include_subdirs unqualified)

(library
 (name writ_lsp)
 (libraries writ_data writ_syntax writ_runtime writ_json))

; The version `initialize` reports in serverInfo; the same rule as
; tooling/cli/dune (which explains the stripped leading `v`).

(rule
 (targets version.ml)
 (action
  (with-stdout-to
   version.ml
   (echo
    "let v =\n  let raw = \"%{version:writ}\" in\n  if String.length raw > 1 && raw.[0] = 'v' && raw.[1] >= '0' && raw.[1] <= '9'\n  then String.sub raw 1 (String.length raw - 1)\n  else raw\n"))))
