; The language server process. It is the only executable that links [writ_lsp],
; and the only file in the LSP tree allowed to perform I/O — the read/write loop
; lives here so every module it drives stays a function from values to values.

; Installed alongside `writ` as `writ-lsp`, so an editor on a machine that only
; ran `opam install writ` still gets diagnostics from the real engine.

(executable
 (name writ_lsp)
 (public_name writ-lsp)
 (package writ)
 (modules writ_lsp)
 (libraries writ_data writ_syntax writ_runtime writ_lsp writ_loadpath))
