#!/bin/sh
# Find the pol MCP server and become it.
#
# DOCKER IS THE DEFAULT, and that is a deliberate inversion of what you might
# expect. This plugin exists for people who want pol inside Claude and have no
# reason to own a pol checkout — for them a container is not a fallback, it is
# the whole delivery mechanism, and it means nothing native is ever installed.
# Anyone who does have pol built locally is already served by that repository's
# own .mcp.json; they can still get it here with POL_MCP_NATIVE=1.
#
# Order:
#   1. $POL_MCP              — an operator who means one particular build
#   2. native, if POL_MCP_NATIVE=1
#   3. Docker                — the default
#   4. native                — Docker absent, but pol is installed
#
# Nothing is written to STDOUT: stdout is the protocol stream, and one stray
# line is a message the client cannot parse. That is why the pull below is
# redirected — `docker pull` is chatty, and its progress on stdout would
# corrupt the session before it began. Diagnostics go to stderr, the only place
# a human learns why the server did not start.
set -eu

# Pinned to the version this plugin ships with, so the tools answering are the
# ones its skill describes. Override for a different build.
POL_IMAGE=${POL_IMAGE:-ghcr.io/sajonaro/pol:0.1.0}

native() {
  if command -v pol-mcp >/dev/null 2>&1; then
    exec pol-mcp "$@"
  fi
  # An install predating the MCP server leaves `pol` without its sibling.
  p=$(command -v pol 2>/dev/null || true)
  if [ -n "$p" ] && [ -x "$(dirname "$p")/pol-mcp" ]; then
    exec "$(dirname "$p")/pol-mcp" "$@"
  fi
  return 1
}

docker_run() {
  # Fetch before exec, so a pull failure is EXPLAINED rather than surfacing as
  # a server that died. Both streams to stderr: see the note about stdout.
  if ! docker image inspect "$POL_IMAGE" >/dev/null 2>&1; then
    echo "pol: fetching $POL_IMAGE (first run only)…" >&2
    if ! docker pull "$POL_IMAGE" >&2 2>&1; then
      cat >&2 <<MSG
pol: could not pull $POL_IMAGE.

If it is private you need to authenticate once:

    echo \$GITHUB_TOKEN | docker login ghcr.io -u YOUR_USERNAME --password-stdin

Or point POL_IMAGE at an image you can reach, or install pol natively and set
POL_MCP_NATIVE=1.
MSG
      exit 127
    fi
  fi
  # -i, never -t: this is a pipe, and a TTY would rewrite the bytes.
  #
  # THE MOUNT IS THE TRICK. The tools take PATHS, and a host path means nothing
  # inside a container. Mounting the working directory AT ITS OWN PATH makes
  # absolute and relative paths alike resolve to the files the caller meant.
  # Read-only: every exposed tool only reads.
  #
  # The limit, and it is real: a model OUTSIDE that directory is invisible.
  exec docker run --rm -i -v "$PWD:$PWD:ro" -w "$PWD" \
    --entrypoint pol-mcp "$POL_IMAGE" "$@"
}

[ -n "${POL_MCP:-}" ] && exec "$POL_MCP" "$@"

if [ "${POL_MCP_NATIVE:-0}" = "1" ]; then
  native "$@" || {
    echo "POL_MCP_NATIVE=1 but no pol-mcp on PATH. Install pol, or unset it to use Docker." >&2
    exit 127
  }
fi

command -v docker >/dev/null 2>&1 && docker_run "$@"

native "$@" || true

cat >&2 <<'MSG'
pol-mcp is not available: no docker, and no pol installed.

This plugin runs the server in a container by default, so Docker is the only
thing it normally needs. Either install Docker, or install pol —

    opam install pol            # or scripts/with-ocaml.sh dune build
rm -rf "/root/.local/share/pol/lib"
mkdir -p "/root/.local/bin" "/root/.local/share/pol/lib"
for exe in pol pol-lsp pol-mcp; do \
  rm -f "/root/.local/bin/$exe"; \
  cp -fL "_build/install/default/bin/$exe" "/root/.local/bin/$exe"; \
  chmod u+w "/root/.local/bin/$exe"; \
done
cp -f core/stdlib/* "/root/.local/share/pol/lib/" from a checkout of
                                # github.com/sajonaro/pol

If your pol-mcp lives somewhere unusual, set POL_MCP to it.
MSG
exit 127
