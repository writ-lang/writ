#!/bin/sh
# Copyright (C) 2026 Alex Kunich
# SPDX-License-Identifier: AGPL-3.0-or-later
# Find the writ MCP server and become it.
#
# DOCKER IS THE DEFAULT, and that is a deliberate inversion of what you might
# expect. This plugin exists for people who want writ inside Claude and have no
# reason to own a writ checkout — for them a container is not a fallback, it is
# the whole delivery mechanism, and it means nothing native is ever installed.
# Anyone who does have writ built locally is already served by that repository's
# own .mcp.json; they can still get it here with WRIT_MCP_NATIVE=1.
#
# Order:
#   1. $WRIT_MCP              — an operator who means one particular build
#   2. native, if WRIT_MCP_NATIVE=1
#   3. Docker                — the default
#   4. native                — Docker absent, but writ is installed
#
# Nothing is written to STDOUT: stdout is the protocol stream, and one stray
# line is a message the client cannot parse. That is why the pull below is
# redirected — `docker pull` is chatty, and its progress on stdout would
# corrupt the session before it began. Diagnostics go to stderr, the only place
# a human learns why the server did not start.
set -eu

# Pinned to the version this plugin ships with, so the tools answering are the
# ones its skill describes. Override for a different build.
WRIT_IMAGE=${WRIT_IMAGE:-ghcr.io/writ-lang/writ:0.1.0}

native() {
  if command -v writ-mcp >/dev/null 2>&1; then
    exec writ-mcp "$@"
  fi
  # An install predating the MCP server leaves `writ` without its sibling.
  p=$(command -v writ 2>/dev/null || true)
  if [ -n "$p" ] && [ -x "$(dirname "$p")/writ-mcp" ]; then
    exec "$(dirname "$p")/writ-mcp" "$@"
  fi
  return 1
}

docker_run() {
  # Fetch before exec, so a pull failure is EXPLAINED rather than surfacing as
  # a server that died. Both streams to stderr: see the note about stdout.
  if ! docker image inspect "$WRIT_IMAGE" >/dev/null 2>&1; then
    echo "writ: fetching $WRIT_IMAGE (first run only)…" >&2
    if ! docker pull "$WRIT_IMAGE" >&2 2>&1; then
      cat >&2 <<MSG
writ: could not pull $WRIT_IMAGE.

If it is private you need to authenticate once:

    echo \$GITHUB_TOKEN | docker login ghcr.io -u YOUR_USERNAME --password-stdin

Or point WRIT_IMAGE at an image you can reach, or install writ natively and set
WRIT_MCP_NATIVE=1.
MSG
      exit 127
    fi
  fi
  # -i, never -t: this is a pipe, and a TTY would rewrite the bytes.
  #
  # THE MOUNT IS THE TRICK. The tools take PATHS, and a host path means nothing
  # inside a container. Mounting the working directory AT ITS OWN PATH makes
  # absolute and relative paths alike resolve to the files the caller meant.
  # Read-only: every exposed tool only reads.
  #
  # The limit, and it is real: a model OUTSIDE that directory is invisible.
  exec docker run --rm -i -v "$PWD:$PWD:ro" -w "$PWD" \
    --entrypoint writ-mcp "$WRIT_IMAGE" "$@"
}

[ -n "${WRIT_MCP:-}" ] && exec "$WRIT_MCP" "$@"

if [ "${WRIT_MCP_NATIVE:-0}" = "1" ]; then
  native "$@" || {
    echo "WRIT_MCP_NATIVE=1 but no writ-mcp on PATH. Install writ, or unset it to use Docker." >&2
    exit 127
  }
fi

command -v docker >/dev/null 2>&1 && docker_run "$@"

native "$@" || true

cat >&2 <<'MSG'
writ-mcp is not available: no docker, and no writ installed.

This plugin runs the server in a container by default, so Docker is the only
thing it normally needs. Either install Docker, or install writ —

    opam install writ            # or scripts/with-ocaml.sh dune build
rm -rf "/root/.local/share/writ/lib"
mkdir -p "/root/.local/bin" "/root/.local/share/writ/lib"
for exe in writ writ-lsp writ-mcp; do \
  rm -f "/root/.local/bin/$exe"; \
  cp -fL "_build/install/default/bin/$exe" "/root/.local/bin/$exe"; \
  chmod u+w "/root/.local/bin/$exe"; \
done
cp -f core/stdlib/* "/root/.local/share/writ/lib/" from a checkout of
                                # github.com/writ-lang/writ

If your writ-mcp lives somewhere unusual, set WRIT_MCP to it.
MSG
exit 127
