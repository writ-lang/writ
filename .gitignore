# ── OCaml / dune ─────────────────────────────────────────────
/_build/
*.install
*.merlin
*.annot
*.cmi
*.cmo
*.cmx
*.cmt
*.cmti
*.cma
*.cmxa
*.cmxs
*.o
*.a
*.so
*.byte
*.native
*.exe
*.coverage
bisect*.coverage
/_coverage/

# ── opam ─────────────────────────────────────────────────────
# A switch created inside the checkout (opam switch create .).
/_opam/
# writ.opam is generated but committed: `opam install .` needs it in the sources.

# ── Release output (make release) ────────────────────────────
/dist/

# ── Python bytecode ──────────────────────────────────────────
__pycache__/
*.py[cod]

# ── Certificates ─────────────────────────────────────────────
# Written beside every checked model; the lean/Examples ones are proof fixtures.
*.cert.json
!/lean/Examples/*.cert.json

# ── Merge and patch leftovers ────────────────────────────────
*.orig
*.rej

# ── Editor / OS cruft ────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
/.vscode/

# ── Local tooling and environment state (not project source) ─
.omc/
.afk-flow/
.claude/settings.local.json
.direnv/
.env
